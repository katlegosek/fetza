# TODO(production): Set EXPO_PUBLIC_API_URL per environment in CI/release — not ngrok/localhost.
# Rails API base URL (no trailing slash).
# Simulator: http://localhost:3000
# Physical device (same Wi‑Fi): http://<your-mac-ip>:3000
# Physical device (easiest): https://<subdomain>.ngrok-free.dev (or .app)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Browser app origin used to build shareable guest links.
EXPO_PUBLIC_WEB_APP_URL=http://localhost:8081

# Auth: enabled by default in __DEV__. Set to "false" to skip login during local work.
# EXPO_PUBLIC_AUTH_ENABLED=true
# EXPO_PUBLIC_AUTH_ENABLED=false
